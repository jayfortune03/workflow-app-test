{
  "name": "workflow-app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -r \"cross-env NODE_ENV=development vite\" \"npm:electron:dev\"",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "electron:dev": "wait-on tcp:3000 && cross-env NODE_ENV=development electron .",
    "build:web": "vite build",
    "build:electron": "cross-env NODE_ENV=production electron-builder",
    "build": "npm run build:web && npm run build:electron"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.7",
    "@mdi/font": "7.4.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.47.0",
    "@vue-flow/minimap": "^1.5.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.1",
    "wait-on": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "sass-embedded": "^1.92.1",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vuetify": "^2.1.2",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.workflow.app",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
